APP_ENV=local
SECRET_KEY=change-me
DATA_MODE=synthetic
SYNTHETIC_SEED=42
SYNTHETIC_SYMBOLS=120
SYNTHETIC_YEARS=6
REAL_HISTORY_START=2016-01-01
REAL_HISTORY_YEARS=5
REAL_UNIVERSE_SIZE=120
REAL_UNIVERSE_PREFILTER_SIZE=250
REAL_UNIVERSE_MIN_PRICE=10
REAL_UNIVERSE_MIN_HISTORY_SESSIONS=1000
REAL_TRADE_MIN_HISTORY_SESSIONS=700
REAL_UNIVERSE_MIN_MEDIAN_DOLLAR_VOLUME=50000000
REAL_UNIVERSE_MAX_VOLATILITY=0.65
REAL_UNIVERSE_MIN_SEC_CORE_METRICS=3
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_FEED=iex
TRADING_ENV=PAPER
ALLOW_ALPACA_PAPER_ORDERS=false
PAPER_AUTO_ENABLED=false
SEC_USER_AGENT=QuantLab local research contact@example.com

# Paper Auto schedule (America/New_York). Monday=0 ... Sunday=6
PAPER_AUTO_WEEKDAY=0
PAPER_AUTO_HOUR_ET=9
PAPER_AUTO_MINUTE_ET=35
PAPER_AUTO_TOP_N=20

# Daily research pipeline after US close (America/New_York)
DAILY_PIPELINE_ENABLED=true
DAILY_PIPELINE_HOUR_ET=18
DAILY_PIPELINE_MINUTE_ET=15
DAILY_SEC_REFRESH_WEEKDAY=5

# Autopilot: initialise automatiquement Data -> Research -> META V5 -> Validation -> Signals
AUTO_BOOTSTRAP_ENABLED=true
